# Public base URL of the deployed site — used for sitemap, robots and OG/canonical URLs.
# Set this in your host (e.g. Vercel project settings) to your real domain.
NEXT_PUBLIC_SITE_URL=https://www.veloralivings.in

# ── Velora CMS (/admin) ───────────────────────────────────────────────────
# Copy to .env.local for local dev; set the same in Vercel → Settings →
# Environment Variables for the live site.

# REQUIRED IN PRODUCTION. Password for the /admin CMS login. There is no
# default: if this is unset in a deployed build the CMS refuses every login.
# Never commit the real value — this file is in a public repository.
ADMIN_PASSWORD=

# Optional legacy catalogue backend. Ignored when GitHub is configured.
BLOB_READ_WRITE_TOKEN=

# ── Diagnostics ───────────────────────────────────────────────────────────
# Default target for `npm run check:live`. Override per run with an argument:
#   npm run check:live -- https://staging.example.com
SITE_URL=https://www.veloralivings.in

# ── GitHub Integration (replaces Vercel Blob) ─────────────────────────────
# The admin CMS commits product photos and catalogue data directly to the
# GitHub repo. Runtime reads use the same branch immediately; Vercel still
# deploys code changes. Set these for Production and use a separate preview branch.
#
# Create a fine-grained PAT at https://github.com/settings/tokens?type=beta
# with Contents: Read and write permission on this repository.
GITHUB_TOKEN=
GITHUB_REPO=rushanhaque/Velora
GITHUB_BRANCH=main
